
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>إدارة طلبك - دسوق</title>
<style>
body{font-family:Arial;background:#f1f5f3;margin:0;color:#222}
header{background:#075e46;color:white;padding:20px;text-align:center}
main{max-width:800px;margin:auto;padding:15px}
.card{background:white;border-radius:12px;padding:15px;margin:12px 0}
button{border:0;border-radius:8px;padding:11px;margin:4px;background:#087f5b;color:white;cursor:pointer}
input,select{width:100%;box-sizing:border-box;padding:12px;margin:6px 0;border:1px solid #ccc;border-radius:7px}
.muted{color:#666;font-size:14px}
.status{font-weight:bold;color:#087f5b}
</style>
</head>
<body>
<header>
<h1>📋 لوحة تحكم طلبك - دسوق</h1>
<p>إدارة ومتابعة الطلبات</p>
</header>
<main>
<div class="card">
<h2>📦 الطلبات</h2>
<p class="muted">هذه نسخة أولية. الطلبات لن تظهر هنا تلقائيًا من أجهزة العملاء حتى نربط قاعدة بيانات مشتركة.</p>
<button onclick="loadOrders()">تحديث القائمة</button>
<div id="orders"></div>
</div>
<div class="card">
<h2>➕ تسجيل طلب يدوي</h2>
<form id="form">
<input id="customer" placeholder="اسم العميل" required>
<input id="phone" placeholder="رقم هاتف العميل" required>
<input id="address" placeholder="عنوان التوصيل" required>
<input id="details" placeholder="تفاصيل الطلب" required>
<input id="total" type="number" min="0" placeholder="الإجمالي بالجنيه" required>
<button type="submit">حفظ الطلب</button>
</form>
</div>
</main>
<script>
const KEY="talabak_dasouq_orders";
function getOrders(){
try{return JSON.parse(localStorage.getItem(KEY)||"[]")}catch(e){return []}
}
function saveOrders(orders){
localStorage.setItem(KEY,JSON.stringify(orders));
}
function loadOrders(){
const orders=getOrders();
const box=document.getElementById("orders");
if(!orders.length){box.innerHTML="<p>لا توجد طلبات مسجلة على هذا الجهاز.</p>";return}
box.innerHTML=orders.map((o,i)=>`
<div class="card">
<h3>طلب رقم ${i+1}</h3>
<p>العميل: ${escapeText(o.customer)}</p>
<p>الهاتف: ${escapeText(o.phone)}</p>
<p>العنوان: ${escapeText(o.address)}</p>
<p>التفاصيل: ${escapeText(o.details)}</p>
<p>الإجمالي: ${o.total} جنيه — كاش عند الاستلام</p>
<p>الحالة: <span class="status">${escapeText(o.status)}</span></p>
<select onchange="setStatus(${i},this.value)">
<option ${o.status==="جديد"?"selected":""}>جديد</option>
<option ${o.status==="تم الاستقبال"?"selected":""}>تم الاستقبال</option>
<option ${o.status==="قيد التجهيز"?"selected":""}>قيد التجهيز</option>
<option ${o.status==="خرج للتوصيل"?"selected":""}>خرج للتوصيل</option>
<option ${o.status==="تم التسليم"?"selected":""}>تم التسليم</option>
</select>
<button onclick="sendWhatsApp(${i})">إرسال للمطعم عبر واتساب</button>
<button onclick="deleteOrder(${i})" style="background:#c92a2a">حذف</button>
</div>`).join("");
}
function escapeText(s){
return String(s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
}
document.getElementById("form").addEventListener("submit",e=>{
e.preventDefault();
const orders=getOrders();
orders.push({
customer:document.getElementById("customer").value,
phone:document.getElementById("phone").value,
address:document.getElementById("address").value,
details:document.getElementById("details").value,
total:Number(document.getElementById("total").value),
status:"جديد"
});
saveOrders(orders);
e.target.reset();
loadOrders();
});
function setStatus(i,status){
const orders=getOrders();
orders[i].status=status;
saveOrders(orders);
loadOrders();
}
function deleteOrder(i){
if(!confirm("هل تريد حذف هذا الطلب؟"))return;
const orders=getOrders();
orders.splice(i,1);
saveOrders(orders);
loadOrders();
}
function sendWhatsApp(i){
const o=getOrders()[i];
const msg=`طلب للمطعم - طلبك دسوق\nالعميل: ${o.customer}\nالهاتف: ${o.phone}\nالعنوان: ${o.address}\nالطلب: ${o.details}\nالإجمالي: ${o.total} جنيه\nالدفع: كاش عند الاستلام\nالحالة: ${o.status}`;
window.open("https://wa.me/201042830172?text="+encodeURIComponent(msg),"_blank");
}
loadOrders();
</script>
</body>
</html>

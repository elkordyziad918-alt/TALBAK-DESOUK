
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>طلبك - دسوق</title>
<style>
body{font-family:Arial;background:#f3f6f4;margin:0;color:#222}
header{background:#087f5b;color:white;text-align:center;padding:22px}
main{max-width:700px;margin:auto;padding:14px}
section{background:white;padding:16px;border-radius:12px;margin-bottom:15px}
.products{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}
.item{border:1px solid #ddd;border-radius:10px;padding:12px;text-align:center}
button{background:#087f5b;color:white;border:0;padding:12px;border-radius:8px;cursor:pointer}
input,textarea{box-sizing:border-box;width:100%;padding:12px;margin:7px 0;border:1px solid #ccc;border-radius:7px}
.full{width:100%}
.price{color:#087f5b;font-weight:bold}
</style>
</head>
<body>
<header>
<h1>🍔 طلبك - دسوق</h1>
<p>طلباتك لحد باب البيت داخل محافظة كفر الشيخ</p>
</header>
<main>
<section>
<h2>🍽️ اختار أكلك</h2>
<div class="products" id="products"></div>
</section>
<section>
<h2>🛒 سلة الطلبات</h2>
<div id="cart">السلة فارغة</div>
<h3>الإجمالي: <span id="total">0</span> جنيه</h3>
</section>
<section>
<h2>📍 بيانات التوصيل</h2>
<form id="form">
<input id="name" placeholder="اسم العميل" required>
<input id="phone" type="tel" placeholder="رقم الهاتف" required>
<input id="address" placeholder="العنوان داخل كفر الشيخ" required>
<textarea id="notes" placeholder="ملاحظات للمطعم"></textarea>
<p>💵 الدفع: كاش عند الاستلام</p>
<button class="full" type="submit">تأكيد الطلب عبر واتساب</button>
</form>
</section>
</main>
<script>
const whatsapp="201042830172";
const products=[
 {id:1,name:"برجر",price:100},
 {id:2,name:"وجبة فراخ",price:150},
 {id:3,name:"بيتزا",price:120},
 {id:4,name:"شاورما",price:90},
 {id:5,name:"بطاطس",price:35},
 {id:6,name:"كفتة",price:130}
];
let cart={};

function showProducts(){
 document.getElementById("products").innerHTML=products.map(p=>
 `<div class="item"><h3>${p.name}</h3>
 <p class="price">${p.price} جنيه</p>
 <button type="button" onclick="add(${p.id})">أضف للسلة</button></div>`
 ).join("");
}
function add(id){
 cart[id]=(cart[id]||0)+1;
 showCart();
}
function change(id,n){
 cart[id]=(cart[id]||0)+n;
 if(cart[id]<=0)delete cart[id];
 showCart();
}
function showCart(){
 let items=products.filter(p=>cart[p.id]);
 let total=items.reduce((s,p)=>s+p.price*cart[p.id],0);
 document.getElementById("total").textContent=total;
 document.getElementById("cart").innerHTML=items.length?
 items.map(p=>`<p>${p.name} × ${cart[p.id]}
 <button type="button" onclick="change(${p.id},1)">+</button>
 <button type="button" onclick="change(${p.id},-1)">-</button>
 ${p.price*cart[p.id]} جنيه</p>`).join(""):"السلة فارغة";
}
document.getElementById("form").addEventListener("submit",function(e){
 e.preventDefault();
 let items=products.filter(p=>cart[p.id]);
 if(!items.length){alert("أضف منتجات للسلة أولًا");return;}
 let total=items.reduce((s,p)=>s+p.price*cart[p.id],0);
 let msg="طلب جديد - طلبك دسوق\n";
 msg+="الاسم: "+document.getElementById("name").value+"\n";
 msg+="الهاتف: "+document.getElementById("phone").value+"\n";
 msg+="العنوان: "+document.getElementById("address").value+"\n";
 msg+="الطلبات:\n";
 items.forEach(p=>msg+=p.name+" × "+cart[p.id]+"\n");
 msg+="الإجمالي: "+total+" جنيه\n";
 msg+="الدفع: كاش عند الاستلام\n";
 msg+="ملاحظات: "+document.getElementById("notes").value;
 window.open("https://wa.me/"+whatsapp+"?text="+encodeURIComponent(msg),"_blank");
});
showProducts();
showCart();
</script>
</body>
</html>
